{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autoframe result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "Plan",
        "Prepare",
        "Audit",
        "Work",
        "Verify",
        "CompletionAudit"
      ],
      "type": "string"
    },
    "input_plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_plan_version": {
      "type": "integer",
      "minimum": 0
    },
    "execution_plan_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "edit_scope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "edit_scope",
                  "steps",
                  "verification",
                  "minutes"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "summary",
            "tasks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "ready",
        "recover",
        "completion_candidate",
        "approved",
        "revise",
        "reported",
        "accepted",
        "complete",
        "incomplete",
        "replan",
        "needs_input"
      ],
      "type": "string"
    },
    "route_hint": {
      "enum": [
        null,
        "continue",
        "replan"
      ],
      "type": [
        "null",
        "string"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "task_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "implemented",
              "verified",
              "blocked"
            ],
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "blocker": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "release_condition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reason",
                  "release_condition"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "evidence_ids",
          "remaining",
          "blocker"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "task",
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "set": {
                "type": "object",
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "required": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "depends_on": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "criterion_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "acceptance": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "verification": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "deliverables": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "replacements": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "description",
                  "required",
                  "depends_on",
                  "criterion_ids",
                  "acceptance",
                  "verification",
                  "source_ids",
                  "deliverables",
                  "replacements"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "id",
              "set"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "milestone",
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "set": {
                "type": "object",
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "task_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "acceptance": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "description",
                  "task_ids",
                  "acceptance"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "id",
              "set"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "finding",
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "set": {
                "type": "object",
                "properties": {
                  "task_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "anyOf": [
                      {
                        "enum": [
                          "resolved"
                        ],
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence_refs": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "task_ids",
                  "status",
                  "evidence_refs",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "id",
              "set"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "plan",
              "product"
            ],
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ],
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "content",
          "resolution",
          "task_ids",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "work",
              "task",
              "plan",
              "criterion",
              "finding",
              "progress"
            ],
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "input_signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "hash",
          "target_ids",
          "input_signature"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "task_id",
          "description",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "phase",
    "input_plan_hash",
    "base_plan_version",
    "execution_plan_hash",
    "execution_plan",
    "decision",
    "route_hint",
    "summary",
    "task_results",
    "changes",
    "findings",
    "evidence",
    "progress"
  ],
  "additionalProperties": false
}
