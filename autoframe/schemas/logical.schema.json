{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autoframe logical",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "pending",
              "implemented",
              "verified",
              "blocked",
              "superseded"
            ],
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "blocker": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "release_condition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reason",
                  "release_condition"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "replacements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "description",
          "required",
          "depends_on",
          "criterion_ids",
          "acceptance",
          "verification",
          "source_ids",
          "deliverables",
          "status",
          "evidence_refs",
          "remaining",
          "blocker",
          "replacements"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "task_ids",
          "acceptance"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "plan",
              "product"
            ],
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ],
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "content",
          "resolution",
          "task_ids",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "work",
              "task",
              "plan",
              "criterion",
              "finding",
              "progress"
            ],
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "input_signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "phase": {
            "enum": [
              "Plan",
              "Prepare",
              "Audit",
              "Work",
              "Verify",
              "CompletionAudit"
            ],
            "type": "string"
          },
          "record_path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_manifest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "hash",
          "target_ids",
          "input_signature",
          "phase",
          "record_path",
          "artifact_manifest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "execution_plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "edit_scope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "edit_scope",
                  "steps",
                  "verification",
                  "minutes"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "summary",
            "tasks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "tasks",
    "milestones",
    "findings",
    "evidence",
    "execution_plan"
  ],
  "additionalProperties": false
}
